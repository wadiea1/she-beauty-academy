# Copy this file to .env and fill in real values.

# ---- Database ----
DATABASE_URI=postgresql://postgres:password@localhost:5432/she_academy

# ---- Payload ----
PAYLOAD_SECRET=generate-a-long-random-string

# ---- Site ----
# The site's own absolute base URL — drives metadataBase, canonical/
# hreflang URLs, sitemap entries, and JSON-LD `url` fields (Milestone
# K, src/lib/seo/baseUrl.ts). Set this to the real production domain
# when deploying (Milestone M) — never leave it as localhost or a
# guessed domain in a real environment.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Explicit, deliberate opt-in for search-engine indexing (Milestone K,
# src/app/robots.ts). Safe by default: unset or anything other than
# the literal string "true" means disallowed everywhere. Set to
# "true" ONLY on the real production deployment (Milestone M) — never
# on local dev or a staging/preview environment, since NODE_ENV alone
# can't tell those apart from real production.
ALLOW_SEARCH_INDEXING=false
