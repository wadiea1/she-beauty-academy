# Copy this file to .env and fill in real values for local development.
#
# THE ENVIRONMENT CONTRACT. Every variable the application reads is
# listed here with its scope. `pnpm verify:production` validates this
# same set against the rules in src/lib/config/readiness.ts.
#
# NEVER commit real production credentials, tokens, or secrets — not in
# this file, not anywhere. .env* is gitignored (except this example).
#
# Legend:
#   [required]        must be set in every environment, including local
#   [required-prod]   must be set for a production deployment
#   [optional]        has a safe default
#   [public]          NEXT_PUBLIC_* — inlined into the browser bundle,
#                     so it must never hold anything sensitive


# ---- Database ----------------------------------------------------
# [required] PostgreSQL connection string.
# Production notes:
#   - Use a TLS-enabled connection. Do not add sslmode=disable unless
#     the database is reachable only over a trusted private network.
#   - Sized for a long-running server (Payload uses a connection pool).
#     A serverless/short-lived topology needs a pooler in front.
#   - The same URI is used by `pnpm payload:migrate`, so the migration
#     role needs DDL permissions.
DATABASE_URI=postgresql://postgres:password@localhost:5432/she_academy


# ---- Payload -----------------------------------------------------
# [required] Signing secret for Payload auth sessions/tokens.
# Generate a strong value per environment — never reuse this example,
# never commit the real one. See docs/RUNBOOK.md for the command.
# `verify:production` rejects obvious placeholders and short values in
# production, and never prints the value itself.
PAYLOAD_SECRET=generate-a-long-random-string


# ---- Site --------------------------------------------------------
# [required] [public] The site's own absolute base URL — drives
# metadataBase, canonical/hreflang URLs, sitemap entries and JSON-LD
# `url` fields (Milestone K, src/lib/seo/baseUrl.ts).
# Production must be the real https:// domain. `verify:production`
# rejects localhost and non-https in production. No domain has been
# chosen yet — do not invent one.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# [optional] Explicit, deliberate opt-in for search-engine indexing
# (Milestone K, src/app/robots.ts). Safe by default: unset or anything
# other than the literal string "true" disallows all crawlers.
# Set to "true" ONLY on the real production deployment, and only as the
# LAST launch step — never on local dev, CI, or a preview/staging
# environment, since NODE_ENV alone cannot tell those apart.
ALLOW_SEARCH_INDEXING=false


# ---- Public lead intake (launch gate) ----------------------------
# [optional locally / required-prod] Whether the public consultation
# form accepts real submissions.
#
# Production is fail-closed and needs ALL of:
#   1. ENABLE_PUBLIC_LEAD_INTAKE=true
#   2. a real PRIVACY_POLICY_VERSION (not the unpublished placeholder)
#   3. a durable RATE_LIMIT_DRIVER
# Miss any one and /api/apply returns a neutral 503 and creates zero
# Applications, while the form renders a neutral "temporarily
# unavailable" message.
#
# Outside production it is ENABLED unless set to "false", so local QA
# keeps working. Set it to "false" locally to exercise the disabled
# path. See src/lib/config/readiness.ts.
# ENABLE_PUBLIC_LEAD_INTAKE=true

# [required-prod, once collecting leads] The privacy-policy version
# recorded against every lead's consent (src/lib/legal.ts).
# Unset means the honest placeholder "unpublished-v0", which production
# treats as "no approved policy exists" and refuses to attach to real
# consent records. The real value is a business/legal decision — a date
# or semantic version agreed alongside approved policy text. Do not
# invent one, and do not use AI-generated policy text.
# PRIVACY_POLICY_VERSION=

# [optional] Which rate-limit store backs the public form
# (src/lib/rateLimit.ts). Default "memory".
#   memory  — per-process, resets on restart, NOT shared across
#             instances. Local development only.
# No durable driver is implemented yet; production lead intake stays
# disabled until one exists. Tracked in docs/DEPLOYMENT.md.
# RATE_LIMIT_DRIVER=memory


# ---- Danger zone (never set in production) -----------------------
# Payload's Postgres adapter drops every table when this is "true".
# It exists for local resets only. Never set it on a real deployment.
# PAYLOAD_DROP_DATABASE=
